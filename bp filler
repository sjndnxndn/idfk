makeSection("DEBUG / SNIFFER", nextOrder())

local sniffToggleHandle = nil
local sniffInstalledPara = nil
local sniffInstalled = installDragSniffer()

sniffInstalledPara = makeParagraph("Sniffer Status",
    sniffInstalled and "Installed on ClientIsDragging" or "FAILED - remote not found",
    nextOrder())

sniffToggleHandle = makeToggle("Sniff Drag Remote",
    "When ON, every call to ClientIsDragging:FireServer is printed with args",
    false,
    function(state)
        _G._BPFDragSniffing = state
        if state then
            print("=== SNIFFER ON ===")
            print("Now manually drag a plank in-game. The args the game sends")
            print("will print to this output. Copy them and paste them here.")
            setStatus("Sniffer ON - drag a plank now")
        else
            print("=== SNIFFER OFF ===")
            setStatus("Sniffer OFF")
        end
    end, nextOrder())

makeButton("Reinstall Sniffer",
    "Re-hooks ClientIsDragging in case the remote got replaced",
    function()
        _G._BPFDragSnifferInstalled = false
        local ok = installDragSniffer()
        pcall(function()
            sniffInstalledPara:setDesc(sniffInstalledPara,
                ok and "Installed on ClientIsDragging" or "FAILED - remote not found")
        end)
        setStatus(ok and "Sniffer reinstalled" or "Sniffer failed")
    end, nextOrder())
