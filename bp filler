local function doFill(bp, plankEntry, root, useHold)
    if useHold then
        return holdInBlueprint(bp, plankEntry, root)
    else
        return teleportInBlueprint(bp, plankEntry, root)
    end
end

local function fillAllBlueprints()
    if autoFillRunning then
        autoFillCancel = true
        setStatus("Cancelling...")
        return
    end

    local pl = collectMatchingPlanks()
    if #pl == 0 then
        setStatus("No matching planks")
        return
    end

    local bps = collectBlueprints()
    if #bps == 0 then
        setStatus("No blueprints for " .. selectedPlayer.Name)
        return
    end

    autoFillRunning = true
    autoFillCancel = false
    local mode = autoFillHold and "HOLD" or "TP"
    setStatus(string.format("Auto Fill [%s]: %d bps, %d planks", mode, #bps, #pl))

    task.spawn(function()
        local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
        local plankIdx = 1
        local filled, failed = 0, 0

        for i, bp in ipairs(bps) do
            if autoFillCancel then break end
            if not bp.Parent then continue end

            local plankEntry = nil
            for _ = 1, #pl do
                local e = pl[plankIdx]
                plankIdx = (plankIdx % #pl) + 1
                if e.part and e.part.Parent then
                    if autoFillHold then
                        if not heldPlanks[e.model] then
                            plankEntry = e; break
                        end
                    else
                        plankEntry = e; break
                    end
                end
            end
            if not plankEntry then
                setStatus("Ran out of planks")
                break
            end

            setStatus(string.format("%s %d/%d (%s)", mode, i, #bps, bp.Name))
            local ok = doFill(bp, plankEntry, root, autoFillHold)
            if ok then filled += 1 else failed += 1 end
            setHoldCount()
            task.wait(fillDelay)
        end

        autoFillRunning = false
        setStatus(string.format("Done: %d filled, %d failed", filled, failed))
    end)
end

local function loopTick()
    if loopRunning then return end
    if #collectMatchingPlanks() == 0 then
        setStatus("Loop: waiting for planks...")
        return
    end

    local bps = collectBlueprints()
    if #bps == 0 then return end

    loopRunning = true
    task.spawn(function()
        local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
        local pl = collectMatchingPlanks()
        local plankIdx = 1
        local filled = 0
        local mode = loopHold and "HOLD" or "TP"

        for _, bp in ipairs(bps) do
            if not loopMode then break end
            if not bp.Parent then continue end
            local plankEntry = nil
            for _ = 1, #pl do
                local e = pl[plankIdx]
                plankIdx = (plankIdx % math.max(1, #pl)) + 1
                if e.part and e.part.Parent then
                    if loopHold then
                        if not heldPlanks[e.model] then
                            plankEntry = e; break
                        end
                    else
                        plankEntry = e; break
                    end
                end
            end
            if not plankEntry then break end
            setStatus(string.format("Loop [%s]: %s", mode, bp.Name))
            if doFill(bp, plankEntry, root, loopHold) then filled += 1 end
            setHoldCount()
            task.wait(fillDelay)
        end
        loopRunning = false
        setStatus(string.format("Loop pass: %d filled", filled))
    end)
end

