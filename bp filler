    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, ROW_DROPDOWN)
    frame.BackgroundColor3 = Color3.fromRGB(28, 28, 34)
    frame.BorderSizePixel = 0
    frame.LayoutOrder = order
    frame.Parent = body
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)

    local t = Instance.new("TextLabel")
    t.Size = UDim2.fromOffset(110, ROW_DROPDOWN)
    t.Position = UDim2.fromOffset(8, 0)
    t.BackgroundTransparency = 1
    t.Text = text
    t.TextColor3 = Color3.fromRGB(200, 200, 215)
    t.Font = Enum.Font.GothamMedium
    t.TextSize = 12
    t.TextXAlignment = Enum.TextXAlignment.Left
    t.Parent = frame

    local sel = Instance.new("TextButton")
    sel.Size = UDim2.new(1, -152, 0, 30)
    sel.Position = UDim2.new(0, 118, 0.5, -15)
    sel.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
    sel.BorderSizePixel = 0
    sel.Text = ""
    sel.AutoButtonColor = true
    sel.TextXAlignment = Enum.TextXAlignment.Left
    sel.Parent = frame
    Instance.new("UICorner", sel).CornerRadius = UDim.new(0, 6)
    local ss = Instance.new("UIStroke", sel)
    ss.Color = Color3.fromRGB(55, 55, 70)
    ss.Thickness = 1

    local selLbl = Instance.new("TextLabel")
    selLbl.Size = UDim2.new(1, -26, 1, 0)
    selLbl.Position = UDim2.fromOffset(8, 0)
    selLbl.BackgroundTransparency = 1
    selLbl.Text = tostring(default)
    selLbl.TextColor3 = Color3.fromRGB(230, 230, 240)
    selLbl.Font = Enum.Font.Gotham
    selLbl.TextSize = 12
    selLbl.TextXAlignment = Enum.TextXAlignment.Left
    selLbl.Parent = sel

    local arrow = Instance.new("TextLabel")
    arrow.Size = UDim2.fromOffset(20, 30)
    arrow.Position = UDim2.new(1, -22, 0, 0)
    arrow.BackgroundTransparency = 1
    arrow.Text = "v"
    arrow.TextColor3 = Color3.fromRGB(150, 150, 165)
    arrow.Font = Enum.Font.GothamBold
    arrow.TextSize = 11
    arrow.Parent = sel

    local currentValues = values
    local open = false

    local listFrame = Instance.new("ScrollingFrame")
    listFrame.Name = "DropdownList"
    listFrame.Size = UDim2.fromOffset(220, math.min(#values * 28 + 8, 240))
    listFrame.Position = UDim2.fromOffset(0, 0)
    listFrame.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
    listFrame.BorderSizePixel = 0
    listFrame.Visible = false
    listFrame.ZIndex = 200
    listFrame.ScrollBarThickness = 5
    listFrame.ScrollBarImageColor3 = Color3.fromRGB(90, 90, 105)
    listFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
    listFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
    listFrame.Parent = frame -- Parented to the row frame instead of gui
    Instance.new("UICorner", listFrame).CornerRadius = UDim.new(0, 6)
    local ls = Instance.new("UIStroke", listFrame)
    ls.Color = Color3.fromRGB(80, 80, 105)
    ls.Thickness = 1

    local lLayout = Instance.new("UIListLayout", listFrame)
    lLayout.Padding = UDim.new(0, 2)
    lLayout.SortOrder = Enum.SortOrder.LayoutOrder
    lLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center

    local entries = {}

    local function rebuildEntries()
        for _, e in ipairs(entries) do e:Destroy() end
        entries = {}
        for _, v in ipairs(currentValues) do
            local item = Instance.new("TextButton")
            item.Size = UDim2.new(1, -8, 0, 24)
            item.BackgroundColor3 = Color3.fromRGB(28, 28, 34)
            item.BorderSizePixel = 0
            item.Text = tostring(v)
            item.TextColor3 = Color3.fromRGB(220, 220, 230)
            item.Font = Enum.Font.Gotham
            item.TextSize = 11
            item.Parent = listFrame
            Instance.new("UICorner", item).CornerRadius = UDim.new(0, 4)
            item.MouseButton1Click:Connect(function()
                selLbl.Text = tostring(v)
                listFrame.Visible = false
                open = false
                local ok, err = pcall(onChange, v)
                if not ok then warn("[BPFiller] dropdown error: " .. tostring(err)) end
            end)
            table.insert(entries, item)
        end
        listFrame.Size = UDim2.fromOffset(220, math.min(#currentValues * 28 + 8, 240))
    end
    rebuildEntries()

    local ddHandle

    local function openList()
        closeAllDropdowns(ddHandle)
        -- Position relative to the parent frame, not absolute screen position
        listFrame.Position = UDim2.new(0, 118, 1, 4)
        listFrame.Size = UDim2.fromOffset(
            math.max(180, sel.AbsoluteSize.X),
            math.min(#currentValues * 28 + 8, 240)
        )
        listFrame.Visible = true
        open = true
    end

    local function closeList()
        listFrame.Visible = false
        open = false
    end

    sel.MouseButton1Click:Connect(function()
        if open then closeList() else openList() end
    end)

    ddHandle = {
        Set = function(_, v) selLbl.Text = tostring(v) end,
        SetValues = function(_, newValues)
            currentValues = newValues
            rebuildEntries()
        end,
        close = closeList,
        frame = frame,
        listFrame = listFrame,
    }
    table.insert(openDropdowns, ddHandle)
    return ddHandle
end

UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.UserInputType ~= Enum.UserInputType.MouseButton1
    and input.UserInputType ~= Enum.UserInputType.Touch then return end
    local pos = input.Position
    for _, dd in ipairs(openDropdowns) do
        if dd.listFrame.Visible then
            local ap = dd.listFrame.AbsolutePosition
            local as = dd.listFrame.AbsoluteSize
            local inList = pos.X >= ap.X and pos.X <= ap.X + as.X
                       and pos.Y >= ap.Y and pos.Y <= ap.Y + as.Y
            if not inList then
                dd:close()
            end
        end
    end
end)

