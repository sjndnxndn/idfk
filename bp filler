local function computePanelSize(vp)
    if not vp then vp = Vector2.new(1280, 720) end
    local small = vp.X < 800 or vp.Y < 600
    if small then
        return math.clamp(vp.X - 20, 240, 420),
               math.clamp(vp.Y - 40, 300, 620)
    end
    return math.clamp(vp.X * 0.35, 380, 460),
           math.clamp(vp.Y * 0.75, 420, 640)
end

