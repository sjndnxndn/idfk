local function onViewportChange()
    local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize
    if not vp then return end
    local w, h = computePanelSize(vp)
    local curW = panel.AbsoluteSize.X
    local curH = panel.AbsoluteSize.Y
    if curW > w or curH > h then
        panel.Size = UDim2.fromOffset(math.min(curW, w), math.min(curH, h))
    end
    local pos = panel.AbsolutePosition
    local size = panel.AbsoluteSize
    local nx = math.clamp(pos.X, 0, math.max(0, vp.X - size.X))
    local ny = math.clamp(pos.Y, 0, math.max(0, vp.Y - size.Y))
    if nx ~= pos.X or ny ~= pos.Y then
        panel.Position = UDim2.fromOffset(nx, ny)
    end
end

if workspace.CurrentCamera then
